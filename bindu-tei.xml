<anchor xml:id="_intro1b"/> <note type="witnesses" target="#range(right(_intro1b),left(_intro1e))">Jo = Jodhpur MS. No. 2244; G = Chennai GOML Ms. No. R 3239; G<hi rend="sub">pc</hi> = ibid. <hi rend="italic">post correctionem</hi>; M = Mysore ORI Ms. No. B 220.</note><anchor xml:id="_intro1b"/>athavā <app><lem wit="#Jo">dṛṣṭir</lem><rdg wit="#G #Gpc #M">dṛṣṭi</rdg></app> netrayor <app><lem wit="#G #Gpc #M">dvayor</lem><rdg wit="#Jo">dvayo</rdg></app> <app><lem wit="#G #Gpc #M">netrādhobhāgayor</lem><rdg wit="#Jo">netrā 'dhobhāgayor</rdg></app> akṣikūṭayos tad <app><lem resp="#ego" type="emendation">adhogallayor</lem><rdg wit="#ceteri">adhogallayo</rdg></app> <app><lem wit="#G #Gpc">ubhayor</lem><rdg wit="#C #Jo">rūpayor</rdg><rdg wit="#M">rūpa</rdg></app> <app><lem wit="#G #Gpc #Jo">upari</lem><rdg wit="#M">pari</rdg></app> sthirā kartavyā \normalpipe ekānte vijane dīpam <app><lem wit="#Jo">āvarake</lem><rdg wit="#G #Gpc #M">āvake</rdg></app> saṃsthāpya ciraṃ gatvāvalokya stheyam \normalpipe <app><lem wit="#G #Gpc #M">ghaṭīmātraṃ</lem><rdg wit="#J">ghaṭīmātra</rdg></app> vā ghaṭikārdhaṃ vā tato dīpam ācchādya bhūmau sarvatrāvalokane sarvaṃ śvetanīla<app><lem wit="#Jo">pīta</lem><rdg wit="#M">yoṃta</rdg><rdg wit="#G #Gpc">yomta</rdg></app>sphuliṅgasphuliṅga<app><lem wit="#M #G #Gpc">kaṇānte</lem><rdg wit="#Jo">°kaṇāṃ 'te</rdg></app> <app><lem resp="#ego" type="emendation">maṇḍalākārīṇi</lem><rdg wit="#ceteri">maṇḍalākāriṇiś</rdg></app> <app><lem wit="#G #Gpc #M">ceti</lem><rdg wit="#Jo">ceta</rdg></app> jyotiścakrāṇi pañca ṣad vā dṛśyante \normalpipe tataś <app><lem wit="#G #Gpc #Jo">cāṃdhakāre</lem><rdg wit="#M">vāṃdhakāre</rdg></app> dṛśyate \normalpipe dīptimat sarvaṃ svaśarīraṃ dṛśyate \normalpipe bhāsate sarvo 'pi sapradeśo dīptimān sphuṭo dṛśyate \normalpipe <app><lem resp="#ego" type="emendation">ekadārḍhye</lem><rdg wit="#Gpc">ekadārḍye</rdg><rdg wit="#G">etadārḍye</rdg></app> jyotirmayacakrānte parameśvarasya tejomūrtir dṛśyate \normalpipe puṃsaḥ paramānandotpattir jāyate \normalpipe svadehavismṛtiś ca <app><lem wit="#G #Gpc #M">saṃbhavati</lem><rdg wit="#Jo">saṃbhavati | athavā svanetrayor vartmanīr dakṣahastamadhyamātarjanībhyām akṣikū dehavismṛtiś ca saṃbhavati |</rdg></app> \normalpipe  athavā svanetrayor <app><lem wit="#Jo">vartamanīr</lem><rdg wit="#G #Gpc #M">vartmanā</rdg></app> dakṣahastamadhyamātarjanībhyām <app><lem resp="#ego" type="emendation">akṣikuṭayor</lem><rdg wit="#M">ākṣikoṭayor</rdg><rdg wit="#G #Gpc">akṣikūṭakūṭayor</rdg><rdg wit="#Jo">akṣikūtvā</rdg></app> <app><lem wit="#G #Gpc #M">adhaḥ kṛtvā</lem><rdg wit="#Jo">om.</rdg></app> <app><lem wit="#G #Gpc #M">akṣivartmanī</lem><rdg wit="#Jo">akṣivanmanī</rdg></app> dṛḍhaṃ cālanī ye ghaṭikārdhaṃ vā ghaṭīmātraṃ tata evaṃ kṛte <app><lem resp="#ego" type="emendation">sādhakasyāgre</lem><rdg wit="#G #Jo #M">sādhyakasyāgre</rdg></app> <app><lem wit="#G #Jo">suśvetajyotiḥ</lem><rdg wit="#M">suśvītajyotiḥ</rdg></app> prākāśaḥ <app><lem wit="#G #Gpc #M">prāg</lem><rdg wit="#Jo">prāgvad</rdg></app> bhavatīti \normalpipe <anchor xml:id="_intro1e"/><note type="witnesses" target="#right(_intro3b)">PT= <hi rend="italic">Prāṇatoṣiṇī</hi> quotes <hi rend="italic">Yogavarodaya</hi> with reference <hi rend="italic">yogasvarodaye</hi>. YK= <hi rend="italic">Yogakarṇikā</hi> quotes <hi rend="italic">Yogavarodaya</hi> with reference <hi rend="italic">yogasvarodaye</hi>.</note><anchor xml:id="_intro3b"/><hi rend="italic">antarlakṣaṃ śṛṇu <app><lem wit="#PT">subhru</lem><rdg wit="#YK">śukra°</rdg></app> digvidigādivarjitam</hi> | <hi rend="italic"><app><lem wit="#YK">bāhyābhyantara ākāśaṃ vādhāmantraṃ paraṃ mataṃ</lem><rdg wit="#PT">om.</rdg></app></hi> ||<hi rend="italic">calajjāgratsuṣupteṣu bhojaneṣu ca sarvadā</hi> | <hi rend="italic">sarvāvasthāsu deveśi cittaṃ śūnye niyojayet</hi> ||<hi rend="italic">karttā kārayitā <app><lem wit="#YK">śūnyaṃ</lem><rdg wit="#PT">śunyaḥ</rdg></app> mūrtimān śūnya īśvaraḥ</hi> | <hi rend="italic">harṣaśokaghaṭastho ’yaṃ janmamṛtyū labhet svayam</hi> ||<hi rend="italic"><app><lem wit="#YK">ghaṭasthāṃ</lem><rdg wit="#PT">ghaṭasthā</rdg></app> <app><lem wit="#YK">cintayen</lem><rdg wit="#PT">cintyayor</rdg></app> <app><lem wit="#YK">mūrtimitaś</lem><rdg wit="#PT">mūrtir hata°</rdg></app> cintāsvarūpadhṛk</hi> | <hi rend="italic">viṣayaṃ viṣavad <app><lem wit="#YK">dṛṣṭvā</lem><rdg wit="#PT">duṣṭaṃ</rdg></app> tyaktvā jñātvā tu mārutam</hi> ||<hi rend="italic">saṃjñāśūnyamanā bhūtvā puṇyapāpair na lipyate</hi> | <hi rend="italic">bāhyam ābhyantaraṃ <app><lem wit="#PT">khaṃ</lem><rdg wit="#YK">om.</rdg></app> <app><lem resp="#ego" type="emendation">yad</lem><rdg wit="#YK">yad hi</rdg><rdg wit="#PT">hi</rdg></app> antarlakṣam iti smṛtam</hi> ||<hi rend="italic">etaddhyānāt sadā kiñcid duḥkhaṃ na syāc chivo bhavet</hi> | <hi rend="italic">śūnyan tu saccidānandaṃ niḥśabdaṃ brahmaśabditam</hi> | <hi rend="italic">saśabdaṃ jñeyam <app><lem wit="#PT">ākāśam</lem><rdg wit="#YK">ākāśa</rdg></app> iti bhedadvayan tv iha</hi> ||
</body>
